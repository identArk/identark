              "sdks/python",
              "sdks/typescript",
              "guides/production"
            ]
          },
          {
            "group": "Govern",
            "pages": [
              "guides/mcp-hitl",
              "guides/acs",
              "guides/limits-and-errors"
            ]
          },
          {
            "group": "Trust",
            "pages": [
              "guides/security"
            ]
          }
        ]
      },
      {
        "tab": "API Reference",
        "groups": [
